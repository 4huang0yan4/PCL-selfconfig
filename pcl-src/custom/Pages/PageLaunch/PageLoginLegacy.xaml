<Grid x:Class="PageLoginLegacy" Tag="True"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PCL"
      mc:Ignorable="d" d:DesignWidth="297.6">
    <StackPanel Margin="0,0,0,5" x:Name="PanMain">
        <local:MyHint x:Name="HintChinese" Theme="Red" Text="玩家名如果包含英文、数字、下划线以外的内容，可能会无法进入 Minecraft 1.18 以后的世界！" Margin="0,0,0,15" Visibility="Collapsed" />
        <local:MySkin HorizontalAlignment="Center" x:Name="Skin" HasCape="False" Margin="0,0,0,15" />
        <local:MyComboBox IsEditable="True" x:Name="ComboName" Height="28" IsTextSearchEnabled="False" HintText="游戏用户名" />
        <local:MyCheckBox x:Name="CheckUuid" Text="自定义 UUID" Margin="0,12,0,0" ToolTip="默认按玩家名自动生成。只有需要和服务器、其他启动器对齐 UUID 时才打开。" />
        <StackPanel x:Name="PanUuid" Margin="0,8,0,0" Visibility="Collapsed">
            <local:MyHint Theme="Yellow" Text="如果你不清楚 UUID 的作用，请保持关闭。填错会被服务器当成另一个玩家，存档、背包、白名单都可能对不上。" Margin="0,0,0,8" />
            <DockPanel LastChildFill="True">
                <local:MyButton x:Name="BtnCalcUuid" DockPanel.Dock="Right" Text="按名字生成" Margin="8,0,0,0" Padding="12,0"
                                ToolTip="用标准离线算法算出这个玩家名的 UUID（MD5 v3，即 OfflinePlayer:玩家名）。Java 版服务端离线模式、HMCL 等用的就是它。" />
                <local:MyTextBox x:Name="TextUuid" MaxLength="36" HintText="32 位十六进制"
                                ToolTip="带不带连字符都行。留空则用启动器自己的算法生成。" />
            </DockPanel>
            <TextBlock x:Name="LabUuidState" Opacity="0.6" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="留空则按玩家名自动生成。" />
        </StackPanel>
    </StackPanel>
</Grid>
