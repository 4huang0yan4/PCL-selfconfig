<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d" x:Class="PageSetupSystem"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="下载">
                <StackPanel Margin="25,37,25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="27" />
                            <RowDefinition Height="27" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="文件下载源" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboDownloadSource" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadSource" Grid.Column="1">
                            <local:MyComboBoxItem Content="尽量使用镜像源" />
                            <local:MyComboBoxItem Content="优先使用官方源，在加载缓慢时换用镜像源" IsSelected="True" />
                            <local:MyComboBoxItem Content="尽量使用官方源" />
                        </local:MyComboBox>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="版本列表源" Margin="0,0,25,0" Grid.Row="2" />
                        <local:MyComboBox x:Name="ComboDownloadVersion" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadVersion" Grid.Column="1" Grid.Row="2">
                            <local:MyComboBoxItem Content="尽量使用镜像源（可能缺少刚刚更新的版本）" />
                            <local:MyComboBoxItem Content="优先使用官方源，在加载缓慢时换用镜像源" IsSelected="True" />
                            <local:MyComboBoxItem Content="尽量使用官方源" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="最大线程数" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDownloadThread" Grid.Row="4" local:SettingService.Key="ToolDownloadThread" MaxValue="255" Value="63" Grid.Column="1"
                                        ToolTip="线程数越多，限速的文件下载越快，但过高的线程数会造成下载时非常严重的卡顿。&#xa;一般而言，64 线程已可以保证足够的下载速度。" />
                        <TextBlock VerticalAlignment="Center" Grid.Row="5" HorizontalAlignment="Left" Text="速度限制" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDownloadSpeed" Grid.Row="5" local:SettingService.Key="ToolDownloadSpeed" MaxValue="42" Value="42" Grid.Column="1"
                                        ToolTip="设置下载的速度上限，以避免在下载时导致其他需要联网的程序卡死" />
                        <TextBlock VerticalAlignment="Top" Grid.Row="6" HorizontalAlignment="Left" Text="目标文件夹" Margin="0,5,25,5" />
                        <TextBlock Margin="0,5" HorizontalAlignment="Left" Text="请在 启动 → 版本选择 → 文件夹列表 中更改下载目标文件夹。&#xa;在某个文件夹或游戏版本上右键，即可选择打开对应文件夹。" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="社区资源">
                <StackPanel Margin="25,37,25,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="来源" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboDownloadMod" Grid.Row="0" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadMod" Grid.Column="1">
                            <local:MyComboBoxItem Content="尽量使用镜像源（可能缺少刚刚更新的版本）" />
                            <local:MyComboBoxItem Content="仅在官方源加载缓慢时改用镜像源" />
                            <local:MyComboBoxItem Content="尽量使用官方源" IsSelected="True" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="文件名格式" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Row="2" x:Name="ComboDownloadTranslateV2" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadTranslateV2" Grid.Column="1" 
                                          ToolTip="下载社区资源时，其默认文件名的格式">
                            <local:MyComboBoxItem Content="【机械动力】create-1.21.1-6.0.4" />
                            <local:MyComboBoxItem Content="[机械动力] create-1.21.1-6.0.4" IsSelected="True" />
                            <local:MyComboBoxItem Content="机械动力-create-1.21.1-6.0.4" />
                            <local:MyComboBoxItem Content="create-1.21.1-6.0.4-机械动力" />
                            <local:MyComboBoxItem Content="create-1.21.1-6.0.4" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="Mod 管理样式" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Row="4" x:Name="ComboModLocalNameStyle" Grid.ColumnSpan="2" local:SettingService.Key="ToolModLocalNameStyle" Grid.Column="1" 
                                          ToolTip="在 Mod 管理页面中，Mod 项的显示方式">
                            <local:MyComboBoxItem Content="标题显示译名，详情显示文件名" IsSelected="True" />
                            <local:MyComboBoxItem Content="标题显示文件名，详情显示译名" />
                        </local:MyComboBox>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="官方服务凭据" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,40,25,15">
                    <TextBlock Text="如何申请" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,5"
                               Text="微软登录 Client ID：进入 Microsoft Entra 管理中心 → 应用注册 → 新注册，名称随意，受支持的账户类型选「任何 Microsoft Entra 目录中的账户和个人 Microsoft 账户」，重定向 URI 留空；创建后在「概述」页复制「应用程序（客户端）ID」。PCL 使用设备码流，不需要客户端密码。" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,10"
                               Text="CurseForge API Key：登录 CurseForge 开发者控制台 → API Keys → Create API Key，复制生成的密钥（以 $2a$10$ 开头）。官方有效期为 90 天，到期后直连官方源会返回 403，需要重新生成并在这里更新。留空也能搜索，会走 MCIM 镜像。" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="微软登录 Client ID" Margin="0,0,25,0" />
                        <Grid Grid.Column="1">
                            <local:MyTextBox x:Name="TextCredentialMsId" MaxLength="120" HintText="留空则无法使用微软登录"
                                             ToolTip="填在 Entra 应用注册里拿到的「应用程序（客户端）ID」，形如 xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx（此框不允许复制）"
                                             TextChanged="CredentialSecret_TextChanged" />
                            <Border x:Name="MaskCredentialMsId" CornerRadius="3" Margin="1" IsHitTestVisible="False" Visibility="Collapsed"
                                    Background="#FFF2F7FF">
                                <TextBlock x:Name="LabMaskCredentialMsId" VerticalAlignment="Center" Margin="9,0" FontSize="12" Opacity="0.55"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>
                        <local:MyButton x:Name="BtnCredentialMsReveal" Grid.Column="2" Height="30" Text="按住显示" MinWidth="84" Padding="10,0" Margin="10,0,0,0" Tag="Ms"
                                        PreviewMouseLeftButtonDown="BtnReveal_MouseDown" PreviewMouseLeftButtonUp="BtnReveal_MouseUp" MouseLeave="BtnReveal_MouseLeave"
                                        ToolTip="按住显示明文，松开立即恢复隐藏；这个输入框不允许复制，只能粘贴" />
                        <local:MyButton x:Name="BtnCredentialMsSave" Grid.Column="3" Height="30" Text="确认" MinWidth="76" Padding="10,0" Margin="10,0,0,0" ColorType="Highlight"
                                        ToolTip="保存这一行，保存后自动重启启动器让改动生效" />
                        <local:MyButton x:Name="BtnCredentialMsReset" Grid.Column="4" Height="30" Text="重置" MinWidth="76" Padding="10,0" Margin="10,0,0,0"
                                        ToolTip="清空这一行的输入框（不会自动保存，改完点「确认」）" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="CurseForge API Key" Margin="0,0,25,0" />
                        <Grid Grid.Row="2" Grid.Column="1">
                            <local:MyTextBox x:Name="TextCredentialCfKey" MaxLength="120" HintText="留空则只用 MCIM 镜像搜索"
                                             ToolTip="填 CurseForge 控制台生成的密钥，形如 $2a$10$……（此框不允许复制）"
                                             TextChanged="CredentialSecret_TextChanged" />
                            <Border x:Name="MaskCredentialCfKey" CornerRadius="3" Margin="1" IsHitTestVisible="False" Visibility="Collapsed"
                                    Background="#FFF2F7FF">
                                <TextBlock x:Name="LabMaskCredentialCfKey" VerticalAlignment="Center" Margin="9,0" FontSize="12" Opacity="0.55"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>
                        <local:MyButton x:Name="BtnCredentialCfReveal" Grid.Row="2" Grid.Column="2" Height="30" Text="按住显示" MinWidth="84" Padding="10,0" Margin="10,0,0,0" Tag="Cf"
                                        PreviewMouseLeftButtonDown="BtnReveal_MouseDown" PreviewMouseLeftButtonUp="BtnReveal_MouseUp" MouseLeave="BtnReveal_MouseLeave"
                                        ToolTip="按住显示明文，松开立即恢复隐藏；这个输入框不允许复制，只能粘贴" />
                        <local:MyButton x:Name="BtnCredentialCfSave" Grid.Row="2" Grid.Column="3" Height="30" Text="确认" MinWidth="76" Padding="10,0" Margin="10,0,0,0" ColorType="Highlight"
                                        ToolTip="保存 CurseForge 密钥与有效期，保存后自动重启启动器让改动生效" />
                        <local:MyButton x:Name="BtnCredentialCfReset" Grid.Row="2" Grid.Column="4" Height="30" Text="重置" MinWidth="76" Padding="10,0" Margin="10,0,0,0"
                                        ToolTip="清空密钥、有效期恢复默认（不会自动保存，改完点「确认」）" />
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="密钥有效期（天）" Margin="0,0,25,0" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <local:MyTextBox x:Name="TextCredentialCfDays" MaxLength="4" Width="80" HintText="90"
                                             ToolTip="CurseForge 控制台签发的有效期，默认 90 天。改成你申请时看到的天数即可。" />
                            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.5" FontSize="11"
                                       Text="← 天数，随上面 CurseForge 的「确认」一起保存" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="LabCredentialExpire" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" Text="尚未填写 CurseForge 密钥" />
                    <local:MyCheckBox x:Name="CheckCredentialMute" Text="小提示框不再提醒（3 天内仍强制弹窗）" Height="22" Margin="0,0,0,10"
                                      ToolTip="勾选后不再弹「还剩 N 天到期」的小提示框；剩余 3 天内（含已过期）仍会强制弹窗，不受此项影响。" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <local:MyButton x:Name="BtnCredentialEntra" Text="打开 Entra 注册页" MinWidth="150" Padding="13,0" Margin="0,0,15,0" />
                        <local:MyButton x:Name="BtnCredentialCf" Text="打开 CF 控制台" MinWidth="140" Padding="13,0" />
                    </StackPanel>
                    <WrapPanel Margin="0,0,0,12">
                        <local:MyTextButton Text="»  图文教程：微软正版登录" FontSize="13" Margin="0,0,18,4"
                                            local:CustomEventService.EventType="打开帮助" local:CustomEventService.EventData="指南\微软正版登录.json" />
                        <local:MyTextButton Text="»  图文教程：CurseForge 密钥" FontSize="13" Margin="0,0,18,4"
                                            local:CustomEventService.EventType="打开帮助" local:CustomEventService.EventData="指南\CurseForge 密钥.json" />
                    </WrapPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.5" FontSize="11"
                               Text="两行各自独立保存：改完哪行点哪行的「确认」。「重置」= 清空该行（不会自动保存，点「确认」才写入）。确认后弹倒计时框，重启后依然保留。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="下载源（自定义镜像）" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,40,25,15">
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"
                               Text="这里改的是「换哪个镜像站」，不是「要不要用镜像」。它作用于下列下载的镜像前缀：" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="14,0,0,6"
                               Text="· 原版游戏本体文件：客户端 jar、assets、libraries、natives&#xa;· 版本列表（version_manifest.json）&#xa;· 各加载器元数据与安装器：Forge / NeoForge / Fabric / LiteLoader / OptiFine" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,10"
                               Text="不影响：Mojang 官方源地址本身（官方源就写死在他们服务器上）、Modrinth / CurseForge 的模组与整合包资源（那部分走 MCIM 镜像 mod.mcimirror.top，在上面的「社区资源 → 来源」里调）。&#xa;留空 = 默认镜像 BMCLAPI（https://bmclapi2.bangbang93.com）。走不走镜像仍由上面的「文件下载源」「版本列表源」决定。" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="镜像根地址" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextCustomMirror" Grid.Column="1" MaxLength="200" HintText="留空 = https://bmclapi2.bangbang93.com"
                                         ToolTip="例如 https://bmclapi2.bangbang93.com，或自建镜像的根地址；结尾斜杠会自动去掉" />
                        <local:MyButton x:Name="BtnMirrorSave" Grid.Column="2" Height="30" Text="确认" MinWidth="76" Padding="10,0" Margin="10,0,0,0" ColorType="Highlight"
                                        ToolTip="保存并自动重启启动器；下载地址在启动时读取" />
                        <local:MyButton x:Name="BtnMirrorReset" Grid.Column="3" Height="30" Text="重置" MinWidth="76" Padding="10,0" Margin="10,0,0,0"
                                        ToolTip="清空输入框，等于回到默认镜像（不会自动保存，改完点「确认」）" />
                    </Grid>
                    <TextBlock x:Name="LabMirrorStatus" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" Text="当前使用默认镜像。" />
                    <local:MyCheckBox x:Name="ChkLegacyTls" Text="允许旧版 TLS（仅老镜像站连不上时开启）" Height="28" Margin="0,2,0,8"
                                      ToolTip="开启后允许 TLS 1.0 / 1.1，部分老镜像站才能连上；会降低连接安全性。默认关闭，开启时会再确认一次。" />
                    <WrapPanel Margin="0,0,0,10">
                        <local:MyTextButton Text="»  说明：原版游戏下载" FontSize="13" Margin="0,0,18,4"
                                            local:CustomEventService.EventType="打开帮助" local:CustomEventService.EventData="指南\原版游戏下载.json" />
                        <local:MyTextButton Text="»  说明：模组加载器与下载源" FontSize="13" Margin="0,0,18,4"
                                            local:CustomEventService.EventType="打开帮助" local:CustomEventService.EventData="指南\模组加载器与下载源.json" />
                    </WrapPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.5" FontSize="11"
                               Text="下载地址只在启动时读取一次，所以改完点「确认」会自动重启启动器；镜像不可用时下载会退回官方源。" />
                </StackPanel>
            </local:MyCard>

            
            <local:MyCard Margin="0,0,0,15" Title="辅助功能">
                <Grid Margin="25,40,25,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="游戏语言" Margin="0,0,25,0" />
                    <local:MyCheckBox Text="自动设置为中文" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CheckHelpChinese" local:SettingService.Key="ToolHelpChinese" ToolTip="启动游戏时自动把游戏内语言设为简体中文（仅对未手动改过语言的存档生效）" />
                </Grid>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="更新">
                <StackPanel Margin="25,40,25,15">
                    <local:MyCheckBox x:Name="CheckSelfUpdate" Text="检查本分支（GitHub）更新并提示下载" Height="22"
                                      local:SettingService.Key="SystemSelfUpdate"
                                      ToolTip="开启后启动时检查 GitHub 仓库的最新 Release，有新版会提示下载并重启。自用版建议保持关闭，避免被合规发布版覆盖。" />
                </StackPanel>
            </local:MyCard>
