<local:MyPageRight x:Class="PageOtherTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:PCL"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15" Title="百宝箱">
                <StackPanel Margin="25,45,25,20">
                    <local:MyHint Text="开源版把这些开发期的工具整体剥离了，这里补回日常用得到的几个。除了「清理游戏垃圾」，其余都不会改动任何文件。" Theme="Yellow" Margin="0,0,0,15" />
                    <StackPanel Orientation="Horizontal">
                        <local:MyButton x:Name="BtnMemoryOptimize" Text="内存优化" MinWidth="160" Height="34" Padding="16,0" Margin="0,0,15,0" ColorType="Highlight"
                                        ToolTip="把各程序占用的物理内存换出到页面文件，让游戏能拿到更多可用内存。&#xa;效果和任务管理器里看到的「内存占用」下降一致，会在几十秒后逐步回升。" />
                        <local:MyButton x:Name="BtnRubbishClear" Text="清理游戏垃圾" MinWidth="160" Height="34" Padding="16,0"
                                        ToolTip="删除当前版本目录下的 logs、crash-reports、.mixin.out。&#xa;删除前会先列出文件数量与总大小，由你确认。" />
                        <local:MyButton x:Name="BtnSpaceAnalyze" Text="空间分析" MinWidth="160" Height="34" Padding="16,0" Margin="15,0,0,0"
                                        ToolTip="统计每个 Minecraft 文件夹里各子目录占了多少空间，以及启动器自身的数据目录。&#xa;只读取文件大小，不会删除或改动任何文件。" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="自定义下载">
                <StackPanel Margin="25,45,25,20">
                    <local:MyHint Text="填网址就能把文件下到本地，支持任意类型。只认 http / https（网络共享的 UNC 路径不支持）。点开始后会跳到「任务管理」页，在那儿看进度或取消。" Theme="Blue" Margin="0,0,0,15" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="下载地址" />
                        <local:MyTextBox x:Name="TextDlUrl" Grid.Column="1" MaxLength="400" HintText="https://example.com/文件.zip"
                                         ToolTip="只支持 http / https 开头的地址。填完会自动从地址末段猜一个文件名。" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="文件名" />
                        <local:MyTextBox x:Name="TextDlName" Grid.Column="1" MaxLength="180" HintText="留空 = 从地址末段自动推断"
                                         ToolTip="保存成什么名字，要带扩展名；乱填会影响后续能不能打开" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="保存位置" />
                        <local:MyTextBox x:Name="TextDlFolder" Grid.Column="1" MaxLength="260" HintText="留空 = 启动器目录下的 PCL\MyDownload\"
                                         ToolTip="下载到哪个文件夹，不存在会自动建出来" />
                        <local:MyButton x:Name="BtnDlFolderPick" Grid.Column="2" Height="30" Text="选择" MinWidth="76" Padding="10,0" Margin="10,0,0,0"
                                        ToolTip="选择保存文件夹" />
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <local:MyButton x:Name="BtnDlStart" Text="开始下载" MinWidth="110" Height="32" Padding="14,0" ColorType="Highlight"
                                        ToolTip="开始下载；填好地址后即可点击" />
                        <local:MyButton x:Name="BtnDlOpen" Text="打开文件夹" MinWidth="110" Height="32" Padding="14,0" Margin="12,0,0,0"
                                        ToolTip="在资源管理器里打开保存位置；不存在会先建出来" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="快捷文件夹">
                <StackPanel Margin="25,45,25,20">
                    <local:MyHint Text="打开当前选中版本的常用文件夹；不存在的会先建出来。还没选版本时会提示你先选。" Theme="Blue" Margin="0,0,0,15" />
                    <WrapPanel>
                        <local:MyButton x:Name="BtnOpenIndie" Text="游戏目录" MinWidth="140" Height="34" Padding="16,0" Margin="0,0,12,12"
                                        ToolTip="当前版本实际读取的那个 .minecraft 目录" />
                        <local:MyButton x:Name="BtnOpenLogs" Text="日志 logs" MinWidth="140" Height="34" Padding="16,0" Margin="0,0,12,12"
                                        ToolTip="游戏运行日志，崩溃或报错时先看这里最新的那份" />
                        <local:MyButton x:Name="BtnOpenCrash" Text="崩溃报告" MinWidth="140" Height="34" Padding="16,0" Margin="0,0,12,12"
                                        ToolTip="crash-reports 文件夹，游戏崩溃时生成的完整报告" />
                        <local:MyButton x:Name="BtnOpenSaves" Text="存档 saves" MinWidth="140" Height="34" Padding="16,0" Margin="0,0,12,12"
                                        ToolTip="世界存档所在位置，备份或搬运存档用" />
                        <local:MyButton x:Name="BtnOpenMods" Text="模组 mods" MinWidth="140" Height="34" Padding="16,0" Margin="0,0,12,12"
                                        ToolTip="当前版本加载的模组文件夹" />
                        <local:MyButton x:Name="BtnOpenScreenshots" Text="截图 screenshots" MinWidth="140" Height="34" Padding="16,0" Margin="0,0,12,12"
                                        ToolTip="游戏内按 F2 截的图都在这里" />
                        <local:MyButton x:Name="BtnOpenLauncherLog" Text="启动器日志" MinWidth="140" Height="34" Padding="16,0" Margin="0,0,12,12"
                                        ToolTip="启动器自己的日志目录，反馈下载或启动问题时用" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
